# Configuração do LLM (Groq, OpenAI ou Gemini)
GROQ_API_KEY=gsk_...
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# OpenAI API Key (opcional)
# OPENAI_API_KEY=sk-...

# Google Gemini API Key (opcional)
# GOOGLE_API_KEY=AIzaSy...

# Meta WhatsApp Cloud API Configs
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WEBHOOK_VERIFY_TOKEN=meu_token_secreto_whatsapp_123

# Servidor Config
PORT=8000
HOST=0.0.0.0

# Ngrok Config (necessário para rodar o container do Ngrok no Docker)
NGROK_AUTHTOKEN=seu_ngrok_authtoken_aqui

